# NookVM guest kernel: `make allnoconfig KCONFIG_ALLCONFIG=<this file>`.
# Everything needed for the first boot is built in; CONFIG_MODULES stays off.
# scripts/build.sh fails if any line here does not survive in the final
# .config (a dependency silently dropping an option).

CONFIG_LOCALVERSION="-nookvm"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="nookvm"
# CONFIG_MODULES is not set

# General setup
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y

# Platform: ARM64, 4 KiB pages, SMP, DT, PSCI, GICv3, generic timer
CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_SMP=y
CONFIG_OF=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y

# Executables (/init is a #! script)
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Networking: AF_PACKET is required by BusyBox udhcpc
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# Devices
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
