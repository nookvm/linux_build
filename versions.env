# Pinned inputs. Single source of truth for the root scripts and the container
# scripts (plain KEY=value, no quoting, so any sh can source it).

# Linux stable, official kernel.org tree (vendor/linux submodule gitlink).
LINUX_VERSION=6.12.114
LINUX_TAG=v6.12.114
LINUX_TAG_OBJECT=94632db1ce2426a1018af806db3bd3d6f1d04e46
LINUX_COMMIT=85d82e0d7c2dfd3e75d34f35b7ebbf41f45c9c4e
LINUX_URL=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
# Greg Kroah-Hartman, Linux kernel stable release signing key (keys/).
LINUX_TAG_SIGNER_FPR=647F28654894E3BD457199BE38DBBDC86092693E
KERNEL_LOCALVERSION=-nookvm

# Alpine minirootfs, official release (hashes from latest-releases.yaml).
ALPINE_VERSION=3.23.7
ALPINE_MINIROOTFS=alpine-minirootfs-3.23.7-aarch64.tar.gz
ALPINE_MINIROOTFS_URL=https://dl-cdn.alpinelinux.org/alpine/v3.23/releases/aarch64/alpine-minirootfs-3.23.7-aarch64.tar.gz
ALPINE_MINIROOTFS_SHA256=7dcc7420bcc426a615c0512cc85b4a52e9f89df9c600b93ce78d22e0e9234891
ALPINE_MINIROOTFS_SHA512=92c1b6176efb8c95dd0c8ccf2f82f5a5d45d3d7912b1a3f259a62b2f0fc592cdc53999ad47280abd71ac569cfa42bc258087897319d61f89dcae8ae0794409cb

# Builder: Debian 13 (trixie) slim, OCI index digest (linux/arm64 is used),
# with apt pinned to the snapshot.debian.org timestamp the image was cut from.
BUILDER_BASE_IMAGE=debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
DEBIAN_SNAPSHOT=20261020T213255Z
